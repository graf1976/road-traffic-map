# Google Maps JavaScript API キー（必須・ブラウザに公開される）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# Map ID（任意）。未設定の場合は検証用の DEMO_MAP_ID が使われます。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# 規制情報オープンデータの取得元 URL（任意・サーバー側のみで使用）。
# 未設定の場合、規制情報は表示されません（誤った通行止め表示を防ぐため）。
REGULATION_SOURCE_URL=

# 開発用。true にすると取得元が無くても見本データを表示します。
# 実際の規制ではないため、公開環境では設定しないでください。
REGULATION_USE_SAMPLE=
